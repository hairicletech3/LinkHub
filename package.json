{
  "name": "link-tree-hairicle",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./src/output.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "serve": "live-server src --port=3000 --entry-file=index.html",
    "dev": "concurrently -k -n css,serve -c cyan,magenta \"npm:watch:css\" \"npm:serve\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "live-server": "^1.2.2",
    "tailwindcss": "^3.4.13"
  }
}
